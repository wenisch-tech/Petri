{
  "name": "petri-ui",
  "private": true,
  "scripts": {
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i src/main/frontend/petri.css -o target/classes/static/css/petri.css --minify",
    "build:js": "node scripts/build-frontend.mjs",
    "watch:css": "tailwindcss -i src/main/frontend/petri.css -o target/classes/static/css/petri.css --watch",
    "watch:js": "node scripts/build-frontend.mjs --watch"
  },
  "dependencies": {
    "alpinejs": "3.17.5",
    "dompurify": "3.4.17",
    "highlight.js": "11.12.0",
    "lucide": "1.56.0",
    "marked": "14.1.4",
    "monaco-editor": "^0.57.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3"
  },
  "overrides": {
    "@parcel/watcher": "2.6.0",
    "dompurify": "3.4.17",
    "source-map-js": "1.2.2"
  }
}
